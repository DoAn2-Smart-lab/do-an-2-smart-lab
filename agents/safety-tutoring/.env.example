# Copy thanh .env, khong commit .env that (giong quy uoc .env cua Do an 1)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Ban thuc hanh Safety Agent nay phu trach (dinh dang "B0n" - xem file schema)
SAFETY_TABLE_ID=B03

# Ket noi PLC qua python-snap7 (S7comm) - de mac dinh khi chua co PLCSIM that
PLC_IP=192.168.0.1
PLC_RACK=0
PLC_SLOT=1
PLC_DB_NUMBER=2

# Chu ky publish lab/safety/status (giay)
SAFETY_STATUS_INTERVAL_SECONDS=3.0
